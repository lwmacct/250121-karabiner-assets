{
  "title": "m-l1-window",
  "rules": [
    {
      "description": "（m-l1-window）第一层窗口布局切换（m）",
      "manipulators": [
        {
          "description": "cl+m（占满 / 右侧 11/12）",
          "type": "basic",
          "from": {
            "key_code": "m"
          },
          "to": [
            {
              "key_code": "m",
              "modifiers": ["left_control", "left_option", "left_command"]
            }
          ],
          "conditions": [
            {
              "type": "variable_if",
              "name": "lwm_caps_lock",
              "value": 1
            },
            {
              "type": "variable_if",
              "name": "lwm_l2_hold",
              "value": 0
            }
          ]
        }
      ]
    }
  ]
}
